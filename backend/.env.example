# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Name of the MongoDB database
DATABASE_NAME=tola_portfolio

# Deployed frontend URL (set this in Render's environment variables)
# Example: https://tola-portfolio.vercel.app
# Leave blank during local development — localhost origins are always allowed
FRONTEND_URL=
